+        .unwrap();
+        for _ in 0..40 {
+            if egress.is_fatal() {
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+        }
+        assert!(egress.is_fatal(), "the ingress must reject the token");
+        assert!(registry.live().is_empty());
+    }
 }
